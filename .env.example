# -- Telnyx (SMS carrier — required) --
TELNYX_API_KEY=your_api_key
TELNYX_FROM=+1877xxxxxxx
TELNYX_MESSAGING_PROFILE_ID=your_messaging_profile_id
# Webhook public key: portal → Messaging → profile → Webhook public key (base64)
TELNYX_WEBHOOK_PUBLIC_KEY=your_webhook_public_key

# -- Business Config --
BUSINESS_TYPE=default
BUSINESS_NAME=Your Business Name
SERVICE_AREA=Helena, Montana
BUSINESS_OWNER_PHONE=+1406xxxxxxx

# -- Review Engine (#17) --
REVIEW_LINK=https://g.page/r/your-review-link
REVIEW_FOLLOW_UP_HOURS=48
REVIEW_EMAIL_DELAY_HOURS=72

# -- Email fallback (SMTP; optional — skipped when empty) --
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_password
SMTP_FROM=Zero Entry <you@example.com>

# -- LLM Provider (OpenAI-compatible) --
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# -- Server --
HOST=0.0.0.0
PORT=8080
